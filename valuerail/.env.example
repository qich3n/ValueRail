# ValueRail Environment Configuration

# Application settings
APP_NAME=ValueRail
APP_VERSION=1.0.0
DEBUG=false

# Database settings
# For SQLite (local development):
DATABASE_URL=sqlite:///./valuerail.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/valuerail
# CORS Configuration
# Comma-separated list of allowed origins, or "*" for all (development only)
# Production example: CORS_ORIGINS=https://example.com,https://app.example.com
CORS_ORIGINS=*

# Security Settings
# Request size limit in bytes (default: 10MB = 10485760 bytes)
# Configured in main.py MAX_REQUEST_SIZE constant
# Prevents DOS attacks from oversized payloads

# Rate Limiting (configured in API endpoints)
# - Account creation: 30 requests per minute per IP
# - Mint operations: 60 requests per minute per IP
# - Transfer operations: 60 requests per minute per IP
# - List operations: 100 requests per minute per IP